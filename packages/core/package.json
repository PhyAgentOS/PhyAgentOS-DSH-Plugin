{
  "name": "@x-era/forge-core",
  "version": "0.2.1",
  "description": "Host-neutral core for Forge skill management: manifest parsing, catalog and paths",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "tar": "^7.5.2",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "build": "tsc -p ."
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhyAgentOS/PhyAgentOS-DSH-Plugin.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
