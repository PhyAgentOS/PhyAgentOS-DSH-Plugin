{
  "name": "@x-era/dsh-forge-skill",
  "version": "0.2.2",
  "description": "Forge skill catalog for DeepSeek Harness: provider, management tools and doctor",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@x-era/forge-core": "file:../core",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "build": "tsc -p . && node ../../scripts/build-client.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhyAgentOS/PhyAgentOS-DSH-Plugin.git",
    "directory": "packages/skill"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-skill": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
